# Copy this file to .env and fill in the values. Never commit .env.
# On Vercel, set the same variables under Project Settings -> Environment Variables.

# Create a key at Garmin Connect Web -> Personal API Key page.
GARMIN_API_KEY=

# Use https://personal.connectapi.garmin.cn for Garmin China accounts.
GARMIN_API_BASE=https://personal.connectapi.garmin.com

# How long cached API responses stay fresh, in minutes.
CACHE_TTL_MINUTES=60

# Password for the dashboard's login page.
DASHBOARD_PASSWORD=

# Signs the login cookie. Use a long random string, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it logs everyone out.
AUTH_SECRET=
