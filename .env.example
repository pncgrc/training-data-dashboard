# Copy this file to .env and fill in your key. Never commit .env.
# Create a key at Garmin Connect Web -> Personal API Key page.
GARMIN_API_KEY=

# Use https://personal.connectapi.garmin.cn for Garmin China accounts.
GARMIN_API_BASE=https://personal.connectapi.garmin.com

PORT=3000

# How long cached API responses stay fresh, in minutes.
CACHE_TTL_MINUTES=60
